import os
import gymnasium as gym
from gymnasium import spaces
import mujoco
import numpy as np

class ManipulatorEnv(gym.Env):
    metadata = {"render_modes": ["human", "rgb_array"], "render_fps": 50}

    def __init__(self, render_mode=None):
        super().__init__()
        
        xml_path = os.path.join(os.path.dirname(__file__), '../../assets/manipulator/arm_scene.xml')
        self.model = mujoco.MjModel.from_xml_path(xml_path)
        self.data = mujoco.MjData(self.model)

        self.render_mode = render_mode
        self.viewer = None
        
        self.cam_width = 64
        self.cam_height = 64
        self.renderer = mujoco.Renderer(self.model, height=self.cam_height, width=self.cam_width)

        # Action space: 3 Servo Target Positions + 1 Gripper Close Command = 4 control lines
        self.action_space = spaces.Box(low=-1.0, high=1.0, shape=(4,), dtype=np.float32)

        # Observation space tracking modification:
        # qpos(4), qvel(4), target_pos(3), ee_pos(3) = 14 state features
        # 14 + 12288 pixels = 12302 total input dimensions
        self.observation_space = spaces.Box(low=-np.inf, high=np.inf, shape=(12302,), dtype=np.float32)

    def _apply_domain_randomization(self):
        """Modifies physical and visual parameters to bridge the sim-to-real gap."""
        # 1. Randomize Ambient Light Directing Vectors & Values
        light_id = mujoco.mj_name2id(self.model, mujoco.mjtObj.mjOBJ_LIGHT, "scene_light")
        if light_id != -1:
            self.model.light_diffuse[light_id] = self.np_random.uniform(0.6, 1.0, size=3)
            self.model.light_pos[light_id] = self.np_random.uniform([-1.0, -1.0, 3.0], [1.0, 1.0, 5.0])

        # 2. Randomize Material RGB Base Colors for Robot Link Visuals
        mat_id = mujoco.mj_name2id(self.model, mujoco.mjtObj.mjOBJ_MATERIAL, "arm_mat")
        if mat_id != -1:
            # Vary colors within an optimized blue-green spectrum range
            self.model.mat_rgba[mat_id][:3] = self.np_random.uniform([0.0, 0.3, 0.5], [0.2, 0.7, 1.0])

        # 3. Randomize Dynamics Inertia Masses of Link 1 & Link 2 (+/- 15% variance)
        link1_id = mujoco.mj_name2id(self.model, mujoco.mjtObj.mjOBJ_BODY, "link1")
        link2_id = mujoco.mj_name2id(self.model, mujoco.mjtObj.mjOBJ_BODY, "link2")
        self.model.body_mass[link1_id] *= self.np_random.uniform(0.85, 1.15)
        self.model.body_mass[link2_id] *= self.np_random.uniform(0.85, 1.15)

    def _get_obs(self):
        qpos = self.data.qpos.copy()
        qvel = self.data.qvel.copy()
        ee_pos = self.data.site('ee_site').xpos.copy()
        target_pos = self.data.body('target').xpos.copy()
        state_features = np.concatenate([qpos, qvel, target_pos, ee_pos], dtype=np.float32)
        
        self.renderer.update_scene(self.data, camera="main_cam")
        rgb_pixels = self.renderer.render()
        flat_pixels = (rgb_pixels.flatten() / 255.0).astype(np.float32)
        
        return np.concatenate([state_features, flat_pixels], dtype=np.float32)

    def _check_obstacle_collision(self):
        for i in range(self.data.ncon):
            contact = self.data.contact[i]
            geom1_name = mujoco.mj_id2name(self.model, mujoco.mjtObj.mjOBJ_GEOM, contact.geom1)
            geom2_name = mujoco.mj_id2name(self.model, mujoco.mjtObj.mjOBJ_GEOM, contact.geom2)
            
            if (geom1_name == "obs_geom" or geom2_name == "obs_geom"):
                if geom1_name != "floor" and geom2_name != "floor":
                    return True
        return False

    def reset(self, seed=None, options=None):
        super().reset(seed=seed)
        mujoco.mj_resetData(self.model, self.data)

        # Trigger dynamic sim-to-real parameter randomized changes
        self._apply_domain_randomization()

        # Randomize initial object pick location target zone
        self.target_center = np.array([0.4, 0.0, 0.4])
        target_id = self.model.body('target').id
        self.model.body_pos[target_id] = self.target_center.copy()

        # Phase tracking assignment indicator (0 = Approaching Target, 1 = Moving Target to Bin)
        self.task_phase = 0

        # Randomize initial 4 joint servo channels
        self.data.qpos = self.np_random.uniform(-0.1, 0.1, size=4)
        mujoco.mj_forward(self.model, self.data)

        if self.render_mode == "human":
            self.render()

        return self._get_obs(), {}

    def step(self, action):
        target_id = self.model.body('target').id
        ee_pos = self.data.site('ee_site').xpos
        
        # Capture current tracking spatial positions
        current_target_pos = self.model.body_pos[target_id].copy()
        bin_pos = self.data.site('bin_center').xpos
        
        distance_to_target = np.linalg.norm(ee_pos - current_target_pos)

        # Multi-Phase Logic: If the gripper successfully reaches the target object, 
        # the task updates to moving the target directly into the sorting bin structure.
        if self.task_phase == 0 and distance_to_target < 0.05:
            self.task_phase = 1

        if self.task_phase == 1:
            # Simulate holding the object by linking its coordinates directly to the end effector
            self.model.body_pos[target_id] = ee_pos.copy()
            # Calculate distance between the grasped object and the center of the target bin
            active_tracking_distance = np.linalg.norm(ee_pos - bin_pos)
            reward = -active_tracking_distance + 2.0  # Phase shift reward bonus
        else:
            active_tracking_distance = distance_to_target
            reward = -active_tracking_distance

        # 2. Inject and map continuous step actions
        mapped_control = np.zeros(4)
        for i in range(4):
            low, high = self.model.actuator_ctrlrange[i]
            mapped_control[i] = low + 0.5 * (action[i] + 1.0) * (high - low)
        
        self.data.ctrl[:] = mapped_control
        
        # 3. Step physics simulation forward
        for _ in range(10):
            mujoco.mj_step(self.model, self.data)

        obs = self._get_obs()

        # 4. Apply smooth actuation usage control penalty
        reward -= 0.05 * np.sum(np.square(action))

        # 5. Obstacle Avoidance Shape Penalty
        obstacle_pos = self.data.body('obstacle').xpos
        distance_to_obstacle = np.linalg.norm(ee_pos - obstacle_pos)
        if distance_to_obstacle < 0.15:
            reward -= 0.02 / (distance_to_obstacle + 0.001)

        # 6. Handle Critical Terminal Collisions
        terminated = False
        if self._check_obstacle_collision():
            reward -= 50.0
            terminated = True

        # Success condition check: Grasp target and place inside sorting bin area perfectly
        if self.task_phase == 1 and active_tracking_distance < 0.06:
            reward += 100.0
            terminated = True
            print("--- Sorting Task Successfully Completed! ---")

        truncated = self.data.time > 6.0

        if self.render_mode == "human":
            self.render()

        return obs, reward, terminated, truncated, {}

    def render(self):
        if self.render_mode == "human" and self.viewer is None:
            import mujoco.viewer
            self.viewer = mujoco.viewer.launch_passive(self.model, self.data)
        if self.viewer is not None:
            self.viewer.sync()

    def close(self):
        if self.viewer is not None:
            self.viewer.close()
            self.viewer = None
