<mujoco model="spatial_3d_manipulator">
    <compiler coordinate="local" inertiafromgeom="true"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="512" height="512"/>
        <material name="grid_mat" texture="grid" texrepeat="1 1"/>
    </asset>

    <worldbody>
        <geom name="floor" type="plane" size="0 0 .25" material="grid_mat"/>
        <light directional="false" diffuse=".8 .8 .8" pos="0 0 4" dir="0 0 -1"/>

        <!-- Fixed Camera for Visual Observations -->
        <camera name="main_cam" pos="0.6 -0.8 0.6" xyaxes="1 1 0 -0.5 0.5 1"/>

        <!-- Target Object to Track -->
        <body name="target" pos="0.4 0 0.5">
            <geom name="target_geom" type="sphere" size="0.03" rgba="1 0 0 1" mocap="true"/>
        </body>

        <!-- Bounding Spherical Obstacle to Avoid -->
        <body name="obstacle" pos="0.3 0.1 0.35">
            <geom name="obs_geom" type="sphere" size="0.06" rgba="0.8 0.5 0 1"/>
        </body>

        <!-- Robot Base -->
        <body name="base" pos="0 0 0.1">
            <!-- Joint 0: Adds Base Yaw Rotation for Full 3D Spatial Motion -->
            <joint name="joint0" type="hinge" axis="0 0 1" range="-180 180"/>
            <geom name="base_geom" type="cylinder" size="0.1 0.1" rgba="0.5 0.5 0.5 1"/>
            
            <!-- Link 1 -->
            <body name="link1" pos="0 0 0.1">
                <joint name="joint1" type="hinge" axis="0 1 0" range="-90 90"/>
                <geom name="link1_geom" type="capsule" fromto="0 0 0 0 0 0.3" size="0.03" rgba="0 0 1 1"/>
                
                <!-- Link 2 -->
                <body name="link2" pos="0 0 0.3">
                    <joint name="joint2" type="hinge" axis="0 1 0" range="-150 150"/>
                    <geom name="link2_geom" type="capsule" fromto="0 0 0 0 0 0.25" size="0.025" rgba="0 1 0 1"/>
                    
                    <!-- End Effector Tip -->
                    <body name="ee" pos="0 0 0.25">
                        <site name="ee_site" size="0.01" rgba="1 1 0 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor name="motor0" joint="joint0" gear="50.0" ctrlrange="-1 1"/>
        <motor name="motor1" joint="joint1" gear="50.0" ctrlrange="-1 1"/>
        <motor name="motor2" joint="joint2" gear="25.0" ctrlrange="-1 1"/>
    </actuator>
</mujoco>
